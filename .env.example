# Nereus API base URL (no trailing slash).
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
#
# Local API (default port in api/src/server.ts):
VITE_API_BASE_URL=http://localhost:4000

# Example — deployed API:
# VITE_API_BASE_URL=https://your-api.execute-api.eu-west-2.amazonaws.com

# Public base URL for the S3 file bucket (no trailing slash). Partner logos and similar keys load from
# `${VITE_FS_BUCKET_PUBLIC_URL}/${key}`. If omitted, thumbnails use the API presigned download URL instead.
# VITE_FS_BUCKET_PUBLIC_URL=https://nereus-local-fs.s3.eu-west-2.amazonaws.com
